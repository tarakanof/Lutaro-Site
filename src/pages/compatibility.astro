---
import Base from '../layouts/Base.astro';
import { catalogView, sonyOnlyModels } from '../lib/camera-catalog.mjs';
import artifact from '../data/camera-support-catalog.json';
import sony from '../data/sony-ptp3-models.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Throws on an unknown schema or a missing display field, which fails the build.
const view = catalogView(artifact);
// Sony's published list, minus anything the reviewed catalog already covers.
const listed = [...view.documented, ...sonyOnlyModels(sony, view)].sort((a, b) =>
  a.marketingName.localeCompare(b.marketingName, 'en'),
);

// The glyph never carries the meaning alone - every cell also holds a word for
// screen readers.
const GLYPH = { yes: '✓', no: '✕', unstated: '–' };
const WORD = { yes: 'Yes', no: 'No', unstated: 'Not known' };
const routes = (camera) => camera.platforms[0].label.split(' or ');
---
<Base
  title="Lutaro - Sony camera compatibility"
  description="Which Sony cameras work with Lutaro, over USB or Wi-Fi, and at what Picture Profile level. Lutaro is an independent app and is not affiliated with Sony."
>
  <h1>Which Sony cameras work</h1>

  <p>
    Lutaro talks to a camera the same way Sony's own software does. Sony
    publishes which of its bodies speak that protocol and over which connection
    - that is the list below.
  </p>
  <p>
    <strong>Tested</strong> means someone has run Lutaro on that camera. The
    rest is Sony's word, not ours: very likely to work, not promised.
  </p>

  <div class="scroller" role="region" tabindex="0" aria-label="Sony camera compatibility">
    <table class="listed">
      <thead>
        <tr>
          <th scope="col">Camera</th>
          <th scope="col">USB</th>
          <th scope="col">Wi&#8209;Fi</th>
          <th scope="col">Picture&nbsp;Profiles</th>
          <th scope="col">Tested</th>
        </tr>
      </thead>
      <tbody>
        {view.cameras.map((camera) => (
          <tr class="tested">
            <th scope="row">
              <span class="name">{camera.marketingName}</span>
              <span class="code">{camera.bodyCode}</span>
            </th>
            {['USB', 'Wi-Fi'].map((route) => (
              <td class={`mark ${routes(camera).includes(route) ? 'yes' : 'no'}`}>
                <span aria-hidden="true">{routes(camera).includes(route) ? GLYPH.yes : GLYPH.no}</span>
                <span class="sr-only">{routes(camera).includes(route) ? 'Yes' : 'No'}</span>
              </td>
            ))}
            <td class="pp">{camera.pictureProfile.label}</td>
            <td class="mark yes">
              <span aria-hidden="true">{GLYPH.yes}</span>
              <span class="sr-only">Tested with Lutaro</span>
            </td>
          </tr>
        ))}
        {listed.map((camera) => (
          <tr>
            <th scope="row">
              <span class="name">{camera.marketingName}</span>
              {camera.marketingName !== camera.bodyCode && (
                <span class="code">{camera.bodyCode}</span>
              )}
            </th>
            {['USB cable', 'Wi-Fi'].map((carrier) => (
              <td class={`mark ${camera.carrierMarks[carrier]}`}>
                <span aria-hidden="true">{GLYPH[camera.carrierMarks[carrier]]}</span>
                <span class="sr-only">{WORD[camera.carrierMarks[carrier]]}</span>
              </td>
            ))}
            <td class="pp">{camera.pictureProfile || 'Not known'}</td>
            <td class="mark unstated">
              <span aria-hidden="true">{GLYPH.unstated}</span>
              <span class="sr-only">Not tested</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>What the columns mean</h2>
  <dl class="glossary">
    <dt>USB and Wi-Fi</dt>
    <dd>How you can connect. Both work on iPhone, iPad, and Mac.</dd>
    <dt>Picture Profiles: full</dt>
    <dd>Lutaro reads and writes every setting in a PP slot. The normal case.</dd>
    <dt>Picture Profiles: selector only</dt>
    <dd>
      Lutaro can switch which PP slot the camera uses, but cannot read or change
      what is inside one - so profiles from your library cannot be applied.
    </dd>
    <dt>Not known</dt>
    <dd>Nobody has checked yet. It does not mean no.</dd>
  </dl>

  <h2>Bluetooth</h2>
  <p>
    Bluetooth is not a connection on its own. Lutaro uses it to start the
    camera's Wi-Fi hotspot and to wake the camera, then does the real work over
    Wi-Fi. Useful when there is no network to share.
    <a href={`${base}/setup/#bluetooth`}>How to set it up</a>.
  </p>

  <h2>Camera not listed?</h2>
  <p>
    Sony's list covers 2020 and later bodies only. If yours is missing, connect
    it by USB and run <em>Settings → Diagnostics → Camera compatibility</em> in
    the app, then <a href={`${base}/support/`}>send us the result</a>. That is how a
    camera gets tested.
  </p>
  <p>
    If it is listed but will not connect, check the
    <a href={`${base}/setup/`}>setup guide</a> first - most of the time it is a
    camera setting.
  </p>
  <p class="meta">
    Camera list from Sony's Camera Remote Command documentation
    ({sony.package}). Sony says which bodies speak the protocol; only the
    Tested rows have been run with Lutaro. Lutaro is not affiliated with Sony.
  </p>

  <style>
    .sr-only {
      position: absolute;
      width: 1px; height: 1px;
      padding: 0; margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    /* The table scrolls inside its own box so the PAGE never scrolls sideways;
       the region is focusable so it stays reachable by keyboard. */
    .scroller {
      overflow-x: auto;
      margin: 1.6rem 0 0;
      border: 1px solid var(--border);
      border-radius: 12px;
    }
    .scroller:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
    .listed { margin: 0; border-collapse: collapse; width: 100%; font-size: 0.9em; }
    .listed th, .listed td {
      border: 0;
      border-bottom: 1px solid var(--border);
      padding: 0.5rem 0.7rem;
      /* Contains the absolutely-positioned .sr-only spans. Without this their
         containing block is the page, so a cell scrolled out of the table's
         overflow box drags the PAGE's scroll width out with it. */
      position: relative;
    }
    .listed tbody tr:last-child th,
    .listed tbody tr:last-child td { border-bottom: 0; }
    .listed thead th {
      background: var(--surface);
      font-size: 0.84em;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-secondary);
      white-space: nowrap;
    }
    .listed tbody th { font-weight: 600; text-align: left; white-space: nowrap; }
    .listed .name { display: block; }
    .listed .code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.8em;
      font-weight: 400;
      color: var(--text-secondary);
    }
    .listed .mark { text-align: center; font-weight: 600; width: 1%; white-space: nowrap; }
    .listed .mark.yes { color: #1a7f37; }
    .listed .mark.no { color: #b3261e; }
    .listed .mark.unstated { color: var(--text-tertiary); }
    .listed .pp { color: var(--text-secondary); white-space: nowrap; }
    .listed tr.tested { background: var(--surface); }
    @media (prefers-color-scheme: dark) {
      .listed .mark.yes { color: #56d364; }
      .listed .mark.no { color: #ff7b72; }
    }
    .glossary dt { font-weight: 600; margin-top: 0.9rem; }
    .glossary dd { margin: 0.2rem 0 0; color: var(--text-secondary); }
  </style>
</Base>
